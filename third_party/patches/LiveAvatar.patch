+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""
+为数字人视频生成参考人像图片
+使用 Nano-Banana-Pro (gemini-3-pro-image) 模型生成高质量肖像
+
+用法:
+    python generate_ref_portraits.py \
+        --tsv $IT2AV_WORKSPACE/data/text/digit/digit_test.tsv \
+        --output-dir $IT2AV_WORKSPACE/data/pics/digit/ \
+        --num-portraits 2   # 每个样本生成几张候选人像 (默认 2, 选最好的)
+"""
+
+import argparse
+import base64
+import csv
+import json
+import os
+import re
+import sys
+import time
+from datetime import datetime
+from pathlib import Path
+from typing import Optional
+
+import requests
+
+
+# ================= 配置区域 =================
+ENV_VENUS_OPENAPI_SECRET_ID = os.environ.get(
+    'ENV_VENUS_OPENAPI_SECRET_ID',
+    ''
+)
+PROXY_TOKEN = ENV_VENUS_OPENAPI_SECRET_ID + "@" + os.environ.get("VENUS_APP_GROUP_ID", "")
+API_URL = os.environ.get("VENUS_API_BASE", "").rstrip("/") + "/llmproxy/chat/completions"
+MODEL_NAME = "gemini-3-pro-image"
+
+
+# ================= 人像 Prompt 模板 =================
+# 根据播报内容的主题，生成不同风格的新闻主播/播报员人像
+PORTRAIT_PROMPTS = [
+    # 男性新闻主播
+    (
+        "A professional Chinese male news anchor in his 30s, wearing a formal dark navy suit "
+        "with a red tie, sitting at a modern news desk. He has a confident, warm smile with "
+        "neat short black hair. Professional studio lighting, clean background with subtle "
+        "gradient. Upper body portrait, facing the camera directly. "
+        "Photorealistic, high resolution, 4K quality, sharp details."
+    ),
+    # 女性新闻主播
+    (
+        "A professional Chinese female news anchor in her late 20s, wearing an elegant "
+        "burgundy blazer over a white blouse, sitting at a modern broadcast studio desk. "
+        "She has a warm, approachable smile with shoulder-length straight black hair. "
+        "Professional studio lighting, clean background. Upper body portrait, facing camera. "
+        "Photorealistic, high resolution, 4K quality, sharp details."
+    ),
+    # 健康科普主播 (适合羊肉/健康类话题)
+    (
+        "A friendly Chinese female health expert in her early 30s, wearing a clean white "
+        "lab coat over a light blue shirt, standing in a modern medical office. She has "
+        "a gentle, trustworthy smile with her hair tied in a neat ponytail. Warm natural "
+        "lighting, bookshelf background with medical books. Upper body portrait, facing camera. "
+        "Photorealistic, high resolution, 4K quality."
+    ),
+]
+
+
+def call_banana_api(messages: list, max_tokens: int = 4000) -> dict:
+    """调用 Nano-Banana-Pro API 生成图片"""
+    payload = {
+        'model': MODEL_NAME,
+        'messages': messages,
+        'max_tokens': max_tokens
+    }
+    headers = {
+        'Content-Type': 'application/json',
+        'Authorization': f'Bearer {PROXY_TOKEN}'
+    }
+
+    try:
+        response = requests.post(API_URL, headers=headers, data=json.dumps(payload), timeout=120)
+        if response.status_code == 200:
+            return {"success": True, "data": response.json()}
+        else:
+            return {"success": False, "error": f"HTTP {response.status_code}: {response.text}"}
+    except Exception as e:
+        return {"success": False, "error": str(e)}
+
+
+def extract_and_save_images(response_data: dict, output_path: str) -> list:
+    """从 API 响应中提取并保存图片"""
+    saved_images = []
+    try:
+        message = response_data['choices'][0]['message']
+        content = message.get('content', [])
+
+        if isinstance(content, list):
+            for idx, item in enumerate(content):
+                if item.get('type') == 'venus_multimodal_url':
+                    multimodal_data = item.get('venus_multimodal_url', {})
+                    image_url = multimodal_data.get('url', '')
+                    mime_type = multimodal_data.get('mimeType', 'image/png')
+
+                    if image_url.startswith('data:'):
+                        ext = 'png' if 'png' in mime_type else 'jpg'
+                        if idx == 0:
+                            save_path = output_path
+                        else:
+                            base, orig_ext = os.path.splitext(output_path)
+                            save_path = f"{base}_{idx}{orig_ext}"
+
+                        # 移除 data:image 前缀
+                        img_data = image_url.split(',', 1)[1]
+                        with open(save_path, 'wb') as f:
+                            f.write(base64.b64decode(img_data))
+
+                        file_size = os.path.getsize(save_path) / 1024
+                        print(f"    ✅ 图片已保存: {save_path} ({file_size:.1f} KB)")
+                        saved_images.append(save_path)
+        elif isinstance(content, str):
+            print(f"    ⚠️  模型返回文本 (非图片): {content[:200]}...")
+
+    except Exception as e:
+        print(f"    ❌ 提取图片失败: {e}")
+
+    return saved_images
+
+
+def generate_portrait(prompt: str, output_path: str) -> list:
+    """生成一张参考人像"""
+    messages = [
+        {
+            'role': 'user',
+            'content': [
+                {
+                    'type': 'text',
+                    'text': f"Generate an image based on this description:\n{prompt}"
+                }
+            ]
+        }
+    ]
+
+    result = call_banana_api(messages, max_tokens=4000)
+    if result["success"]:
+        return extract_and_save_images(result['data'], output_path)
+    else:
+        print(f"    ❌ API 调用失败: {result['error']}")
+        return []
+
+
+def load_tsv_samples(tsv_path: str) -> list:
+    """加载 TSV 测试样本"""
+    samples = []
+    with open(tsv_path, 'r', encoding='utf-8') as f:
+        reader = csv.DictReader(f, delimiter='\t')
+        for idx, row in enumerate(reader):
+            samples.append({
+                'id': idx,
+                'title': row.get('文章标题', '').strip(),
+                'url': row.get('新闻链接', '').strip(),
+                'text': row.get('播客文本', '').strip(),
+            })
+    return samples
+
+
+def select_prompt_for_topic(title: str, idx: int) -> tuple:
+    """根据话题选择合适的人像 prompt"""
+    title_lower = title.lower()
+
+    # 健康/养生类
+    if any(kw in title_lower for kw in ['羊肉', '高血压', '健康', '养生', '饮食', '研究发现']):
+        prompt = PORTRAIT_PROMPTS[2]  # 健康科普主播
+        style = "health_expert"
+    # 交替使用男女主播
+    elif idx % 2 == 0:
+        prompt = PORTRAIT_PROMPTS[0]  # 男性新闻主播
+        style = "male_anchor"
+    else:
+        prompt = PORTRAIT_PROMPTS[1]  # 女性新闻主播
+        style = "female_anchor"
+
+    return prompt, style
+
+
+def main():
+    parser = argparse.ArgumentParser(description="为数字人视频生成参考人像图片")
+    parser.add_argument(
+        "--tsv",
+        type=str,
+        default=os.path.join(os.path.expanduser(os.environ.get("IT2AV_WORKSPACE", "~/it2av_workspace")), "data/text/digit/digit_test.tsv"),
+        help="TSV 样本文件路径",
+    )
+    parser.add_argument(
+        "--output-dir",
+        type=str,
+        default=os.path.join(os.path.expanduser(os.environ.get("IT2AV_WORKSPACE", "~/it2av_workspace")), "data/pics/digit/"),
+        help="人像图片输出目录",
+    )
+    parser.add_argument(
+        "--num-portraits",
+        type=int,
+        default=2,
+        help="每个样本生成几张候选人像 (默认 2)",
+    )
+    args = parser.parse_args()
+
+    # 确保输出目录存在
+    os.makedirs(args.output_dir, exist_ok=True)
+
+    # 加载测试样本
+    print("=" * 70)
+    print("🎨 数字人参考人像生成器")
+    print(f"   模型: {MODEL_NAME}")
+    print(f"   输入: {args.tsv}")
+    print(f"   输出: {args.output_dir}")
+    print(f"   每样本候选数: {args.num_portraits}")
+    print("=" * 70)
+
+    samples = load_tsv_samples(args.tsv)
+    print(f"\n📄 加载了 {len(samples)} 个样本:")
+    for s in samples:
+        print(f"   [{s['id']}] {s['title'][:60]}...")
+
+    total_generated = 0
+
+    for sample in samples:
+        sid = sample['id']
+        title = sample['title']
+        # 清理文件名
+        safe_title = re.sub(r'[^\w\u4e00-\u9fff]', '_', title)[:30]
+
+        print(f"\n{'='*70}")
+        print(f"📝 样本 {sid}: {title[:60]}...")
+        print(f"{'='*70}")
+
+        prompt, style = select_prompt_for_topic(title, sid)
+        print(f"   风格: {style}")
+        print(f"   Prompt: {prompt[:100]}...")
+
+        for n in range(args.num_portraits):
+            output_filename = f"portrait_{sid}_{style}_{n}.png"
+            output_path = os.path.join(args.output_dir, output_filename)
+
+            if os.path.exists(output_path) and os.path.getsize(output_path) > 1024:
+                print(f"\n  [{n+1}/{args.num_portraits}] ⏭️  已存在: {output_filename}")
+                total_generated += 1
+                continue
+
+            print(f"\n  [{n+1}/{args.num_portraits}] ⏳ 生成中...")
+            saved = generate_portrait(prompt, output_path)
+            if saved:
+                total_generated += len(saved)
+            else:
+                print(f"    ⚠️  生成失败，3秒后重试...")
+                time.sleep(3)
+                saved = generate_portrait(prompt, output_path)
+                if saved:
+                    total_generated += len(saved)
+
+            # API 限流保护
+            time.sleep(2)
+
+    print(f"\n{'='*70}")
+    print(f"✅ 人像生成完成!")
+    print(f"   总计生成: {total_generated} 张图片")
+    print(f"   输出目录: {args.output_dir}")
+    print(f"{'='*70}")
+
+    # 打印每个样本的推荐人像
+    print(f"\n📋 各样本对应人像:")
+    for sample in samples:
+        sid = sample['id']
+        _, style = select_prompt_for_topic(sample['title'], sid)
+        portrait_path = os.path.join(args.output_dir, f"portrait_{sid}_{style}_0.png")
+        exists = "✅" if os.path.exists(portrait_path) else "❌"
+        print(f"   [{sid}] {exists} {portrait_path}")
+
+
+if __name__ == "__main__":
+    main()
