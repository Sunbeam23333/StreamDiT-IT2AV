+# 脚本所在目录 (用于定位 tools/ 等相对资源)
+_SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
+
+
+def _resolve_lfs_file(filepath: str,
+                      github_raw_url: str | None = None) -> str:
+    """检查文件是否为 Git LFS 指针, 如果是则从 GitHub 下载真实文件.
+
+    GitHub 的 media.githubusercontent.com 会自动解析 LFS 指针并返回真实文件内容.
+
+    Args:
+        filepath: 待检查的本地文件路径 (绝对路径)
+        github_raw_url: GitHub raw URL, 默认根据文件相对路径自动构建
+    Returns:
+        filepath (已被替换为真实文件)
+    """
+    if not os.path.isfile(filepath):
+        return filepath
+    # LFS 指针文件通常 < 200 字节, 且以 "version https://git-lfs" 开头
+    if os.path.getsize(filepath) > 1024:
+        return filepath  # 真实文件, 无需处理
+    try:
+        with open(filepath, "rb") as f:
+            header = f.read(40)
+        if not header.startswith(b"version https://git-lfs"):
+            return filepath  # 不是 LFS 指针
+    except OSError:
+        return filepath
+
+    # 从 LFS 指针中解析预期大小
+    expected_size = None
+    try:
+        with open(filepath, "r") as f:
+            for line in f:
+                if line.startswith("size "):
+                    expected_size = int(line.strip().split()[-1])
+                    break
+    except Exception:
+        pass
+
+    # 构建 GitHub raw URL
+    if github_raw_url is None:
+        rel_path = os.path.relpath(filepath, _SCRIPT_DIR)
+        github_raw_url = (
+            os.environ.get("SONGGEN_LFS_BASE_URL",
+                           "https://media.githubusercontent.com/media/tencent-ailab/SongGeneration/main")
+            + f"/{rel_path}"
+        )
+
+    print(f"[SongGeneration] {os.path.basename(filepath)} is a Git LFS pointer "
+          f"({os.path.getsize(filepath)} bytes), expected real size: {expected_size} bytes")
+    print(f"[SongGeneration] Downloading from GitHub: {github_raw_url}")
+
+    # 可选代理: IT2AV_PROXY_URL (仅在环境中未配置 HTTP(S)_PROXY 时生效)
+    _proxy_url = os.environ.get("IT2AV_PROXY_URL", "")
+    _proxy_env_set = False
+    if _proxy_url and not os.environ.get("HTTP_PROXY") and not os.environ.get("HTTPS_PROXY"):
+        os.environ["HTTP_PROXY"] = _proxy_url
+        os.environ["HTTPS_PROXY"] = _proxy_url
+        os.environ.setdefault("NO_PROXY", "localhost,127.0.0.1")
+        _proxy_env_set = True
+
+    try:
+        import urllib.request
+        tmp_path = filepath + ".downloading"
+        urllib.request.urlretrieve(github_raw_url, tmp_path)
+        downloaded_size = os.path.getsize(tmp_path)
+
+        # 验证: 下载的文件不能还是 LFS 指针
+        with open(tmp_path, "rb") as f:
+            dl_header = f.read(40)
+        if dl_header.startswith(b"version https://git-lfs"):
+            os.remove(tmp_path)
+            raise RuntimeError("Downloaded file is still a Git LFS pointer")
+
+        # 验证: 如果知道预期大小, 检查是否匹配
+        if expected_size and downloaded_size != expected_size:
+            print(f"[SongGeneration] WARNING: size mismatch (got {downloaded_size}, expected {expected_size})")
+
+        # 替换原文件
+        os.replace(tmp_path, filepath)
+        print(f"[SongGeneration] Downloaded real file: {filepath} ({os.path.getsize(filepath)} bytes)")
+    except Exception as e:
+        # 清理临时文件
+        tmp_path = filepath + ".downloading"
+        if os.path.exists(tmp_path):
+            os.remove(tmp_path)
+        print(f"[SongGeneration] WARNING: Failed to download: {e}")
+        print(f"[SongGeneration] Please manually download:")
+        print(f"[SongGeneration]   curl -L -o '{filepath}' '{github_raw_url}'")
+        raise RuntimeError(
+            f"Cannot load {filepath}: file is a Git LFS pointer and auto-download failed. "
+            f"Manual fix: curl -L -o '{filepath}' '{github_raw_url}'"
+        ) from e
+    finally:
+        if _proxy_env_set:
+            os.environ.pop("HTTP_PROXY", None)
+            os.environ.pop("HTTPS_PROXY", None)
+    return filepath
+
