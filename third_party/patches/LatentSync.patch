diff --git a/latentsync/pipelines/lipsync_pipeline.py b/latentsync/pipelines/lipsync_pipeline.py
index 693155e..62c1306 100644
--- a/latentsync/pipelines/lipsync_pipeline.py
+++ b/latentsync/pipelines/lipsync_pipeline.py
@@ -253,13 +253,51 @@ class LipsyncPipeline(DiffusionPipeline):
         faces = []
         boxes = []
         affine_matrices = []
+        # 用于在人脸检测失败时复用上一帧的结果
+        last_face = None
+        last_box = None
+        last_affine_matrix = None
+        skipped = 0
         print(f"Affine transforming {len(video_frames)} faces...")
-        for frame in tqdm.tqdm(video_frames):
-            face, box, affine_matrix = self.image_processor.affine_transform(frame)
+        for i, frame in enumerate(tqdm.tqdm(video_frames)):
+            try:
+                face, box, affine_matrix = self.image_processor.affine_transform(frame)
+                last_face = face
+                last_box = box
+                last_affine_matrix = affine_matrix
+            except RuntimeError:
+                # 人脸检测失败 (转头/遮挡等), 复用上一帧的结果
+                if last_face is not None:
+                    face, box, affine_matrix = last_face, last_box, last_affine_matrix
+                    skipped += 1
+                else:
+                    # 连第一帧都检测不到, 尝试后续帧
+                    # 先用一个空占位, 后面再回填
+                    faces.append(None)
+                    boxes.append(None)
+                    affine_matrices.append(None)
+                    skipped += 1
+                    continue
             faces.append(face)
             boxes.append(box)
             affine_matrices.append(affine_matrix)
 
+        # 回填开头检测失败的帧 (如果有的话)
+        if last_face is not None:
+            for i in range(len(faces)):
+                if faces[i] is None:
+                    faces[i] = last_face
+                    boxes[i] = last_box
+                    affine_matrices[i] = last_affine_matrix
+                else:
+                    break  # 遇到第一个成功的就不用继续了
+
+        if skipped > 0:
+            print(f"  ⚠️  {skipped}/{len(video_frames)} frames had no face detected, reused nearest neighbor")
+
+        if all(f is None for f in faces):
+            raise RuntimeError("No face detected in any frame of the video")
+
         faces = torch.stack(faces)
         return faces, boxes, affine_matrices
 
