diff --git a/magi_compiler/__init__.py b/magi_compiler/__init__.py
new file mode 100644
index 0000000..2e0bc3c
--- /dev/null
+++ b/magi_compiler/__init__.py
@@ -0,0 +1,18 @@
+"""
+magi_compiler shim — 当 magi_compiler 未安装时提供 no-op fallback。
+
+magi_compiler 是 SandAI 内部的编译优化库 (类似 torch.compile)，
+用于 DiT 模型的推理加速。缺失时本 shim 保证代码可正常运行，
+但不会获得编译加速。
+"""
+
+
+def magi_compile(cls=None, *, config_patch=None):
+    """No-op decorator that returns the original class/function unchanged."""
+    if cls is not None:
+        return cls
+
+    def wrapper(cls_inner):
+        return cls_inner
+
+    return wrapper
diff --git a/magi_compiler/api.py b/magi_compiler/api.py
new file mode 100644
index 0000000..3f02a79
--- /dev/null
+++ b/magi_compiler/api.py
@@ -0,0 +1,21 @@
+"""
+magi_compiler.api shim — no-op fallback for magi_register_custom_op.
+"""
+
+
+def magi_register_custom_op(
+    name=None,
+    *,
+    mutates_args=None,
+    infer_output_meta_fn=None,
+    is_subgraph_boundary=False,
+):
+    """No-op decorator that returns the original function unchanged.
+
+    The real magi_register_custom_op registers functions as torch custom ops
+    for graph compilation. Without the compiler, we just use them as-is.
+    """
+    def wrapper(fn):
+        return fn
+
+    return wrapper
