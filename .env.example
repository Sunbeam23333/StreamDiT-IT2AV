# Copy to .env (git-ignored) and fill in what you need.
# script/common/env.sh sources this file automatically.

# --- Paths ------------------------------------------------------------------
# Shared workspace: models/ data/ results/ output/ (a big or NFS disk)
IT2AV_WORKSPACE=$HOME/it2av_workspace
# Fast local SSD cache; fast_sync.py mirrors models here before loading
IT2AV_LOCAL_ROOT=/tmp/it2av
# Main conda env (video / digital-human / unified TTS)
IT2AV_CONDA_ENV=it2av
# Optional: directory with a static ffmpeg/ffprobe that has libx264
# IT2AV_FFMPEG_DIR=/opt/ffmpeg-7.0.2-amd64-static

# --- Network ------------------------------------------------------------------
# Hugging Face token (gated repos such as FLUX / SD3.5 / Stable Audio Open)
HF_TOKEN=
# HF_ENDPOINT=https://hf-mirror.com
# Proxy for GitHub / Hugging Face / PyPI, exported only if HTTP(S)_PROXY is unset
# IT2AV_PROXY_URL=http://user:password@proxy.example.com:8080
# download/*.py also accept the split form:
# IT2AV_PROXY_HOST=  IT2AV_PROXY_PORT=  IT2AV_PROXY_USER=  IT2AV_PROXY_PASS=

# --- SongGeneration -----------------------------------------------------------
# The upstream GitHub repo (and its LFS file) is offline. If you have the real
# tools/new_auto_prompt.pt (14,959,842 bytes, sha256 616dbe27...34e7), point to it:
# SONGGEN_AUTO_PROMPT=/path/to/new_auto_prompt.pt
# SONGGEN_AUTO_PROMPT_URL=https://your.mirror/new_auto_prompt.pt

# --- Optional private API backends -------------------------------------------
# Hunyuan TTS 2.5 / HunyuanImage 3.0 OpenAPI (used by step1/step2a digit scripts)
# HUNYUAN_API_BASE=
# HUNYUAN_API_KEY=
# Comma-separated host suffixes that should bypass the proxy (e.g. internal COS)
# IT2AV_INTERNAL_DOMAINS=

# Venus-style OpenAI-compatible gateway (agent planner / Nano-Banana / Veo)
# VENUS_API_BASE=
# ENV_VENUS_OPENAPI_SECRET_ID=
# ENV_VENUS_OPENAPI_SECRET_KEY=
# VENUS_APP_GROUP_ID=
# VENUS_PROXY_TOKEN=
